      "properties": {
        "id": 8429259657,
        "osm_type": "node",
        "name": "Abri du Razzu Biancu",
        "shelter_type": "weather_shelter",
        "description": "2020-06 : Simple abri de berger très sommaire, encore parfois utilisé par des spéléologues. Bâti en pierres sèches, exposé au sud, surface ~9m², ni porte ni mobilier, sol en terre battue assez humid. Plafond étanche mais très bas : moins d'1m50 de haut"
      }
    },
